---
import Papa from "papaparse";

import Layout from "../layouts/Layout.astro";
import mainBg from "../assets/images/main-bg.jpg";
import Header from "../components/Header.astro";

import csvContent from "../data/consignment_2026.csv?raw";
import areaMasterContent from "../data/area_master.csv?raw";

const { data: csvData } = Papa.parse(csvContent, { header: true });
const { data: areaMasterData } = Papa.parse(areaMasterContent, { header: true });

// エリアマスターからエリアの順序を取得
const areaOrder = areaMasterData.map(row => row['エリア名']).filter(Boolean);

function getSortKey(area) {
  const index = areaOrder.indexOf(area);
  return [index === -1 ? 999 : index, area];
}

// データを店舗名の50音順でソートする
const sortedData = csvData
  .filter((row) => row["店舗名"])
  .sort((a, b) => a["店舗名"].localeCompare(b["店舗名"], "ja"));

// 実際にデータが存在するエリアのみを、エリアマスターの順序で抽出
const existingAreas = [...new Set(sortedData.map((row) => row["エリア"]))];
const areas = areaOrder.filter(area => existingAreas.includes(area));
---

<Layout title="チケット購入可能店舗" ogImage="">
  <div class="wrapper">
    <div class="main-wrapper">
      <Header />
      <main class="main">
        <div class="section-wrapper">
          <section class="section">
            <h1 class="section-title">チケット購入可能店舗</h1>
            <p class="text-center">美味しい日本酒に出会えるお店はこちら！</p>

            <div class="filter-wrapper">
              <button
                type="button"
                class="filter-button active"
                data-filter="all">すべて</button
              >
              {
                areas.map((area) => (
                  <button
                    type="button"
                    class="filter-button"
                    data-filter={area}
                  >
                    {area.replace('大阪市', '')}
                  </button>
                ))
              }
            </div>

            <div id="store-list" class="consignment-store__grid">
              {
                sortedData.map((row) => (
                  <div class={`store-card ${row["参加店舗"] === "◯" ? "is-participant" : ""}`} data-area={row["エリア"]}>
                    <div><span class="store-card__badge">{row["エリア"]}</span>
                    {row["参加店舗"] === "◯" && <span class="store-card__badge--participant">参加店舗</span>}</div>
                    <h3 class="store-card__name">{row["店舗名"]}</h3>
                    <div class="store-card__info">
                      <p class="store-card__address">
                        <span>
                          <span>{row["住所1"]}</span>
                          {row["住所2"] && <span>{row["住所2"]}</span>}
                        </span>
                      </p>
                      {row["電話番号"] && row["電話番号"] !== "不明" && (
                        <p class="store-card__tel">
                          <a href={`tel:${row["電話番号"]}`}>
                            {row["電話番号"]}
                          </a>
                        </p>
                      )}
                    </div>
                    {row["GoogleマップURL"] && (
                      <div class="store-card__links">
                        <a
                          href={`tel:${row["電話番号"]}`}
                          class="store-card__link--tel"
                        >
                          電話
                        </a>
                        <a
                          href={row["GoogleマップURL"]}
                          target="_blank"
                          class="store-card__link--map"
                        >
                          マップ
                        </a>
                      </div>
                    )}
                  </div>
                ))
              }
            </div>
          </section>
        </div>
      </main>
      <footer class="footer">
        <p class="footer__copy">©︎上方日本酒ワールド ©日本酒卍固め ©SAKAZUKIN</p>
      </footer>
    </div>
    <div class="main__imageBox">
      <img
        class="main__image"
        src="/assets/images/bg.jpg"
        alt=""
        width="1920"
        height="1280"
      />
      <img class="main__image" src={mainBg.src} />
    </div>
  </div>
</Layout>

<style lang="scss">
  .wrapper {
    display: grid;
    height: 100%;
    grid-template-columns: 1fr;
  }
  .main-wrapper {
    width: 100%;
    max-width: 480px;
    margin-inline: auto;
    grid-column: 1/2;
    grid-row: 1/2;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr fit-content(100px);
  }
  .main {
    grid-column: 1/2;
    grid-row: 1/2;
  }
  .section-wrapper {
    position: relative;
    z-index: 1;
    background-color: white;
    width: 100%;
    padding: 1rem 1rem 2rem;
    box-shadow: 0 -2px 2px rgba(0 0 0 /25%);
    background: white url(/assets/images/paper-bg.jpg);
  }
  .footer {
    padding-block: 1rem;
    background-color: #fff;
    text-align: center;
    position: relative;
    z-index: 1;
  }
  .main__imageBox {
    position: fixed;
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-areas: "image";
    grid-column: 1/2;
    grid-row: 1/3;
    z-index: -1;
  }
  .main__image {
    grid-area: image;
    width: 100%;
    height: 100%;
    object-fit: cover;
    // animation: brightness 1s both;
  }
  @keyframes brightness {
    0% {
      filter: brightness(0);
    }
    100% {
      filter: brightness(0.6);
    }
  }
  .main {
    display: grid;
    place-items: center;
  }
  .footer__copy {
    font-size: min(4vw, 1rem);
  }

  .section-title {
    text-align: center;
    &::before {
      content: "";
      display: block;
      width: 77px;
      height: 75px;
      margin-inline: auto;
      opacity: 0;
      background: url(/assets/images/sakazukin.svg) no-repeat
        center/contain;
      animation: title 1s both;
    }
  }
  @keyframes title {
    0% {
      transform: scale(0.9, 1.2) translateY(-100%);
      opacity: 0;
    }
    50% {
      transform: scale(1.2, 0.8) translateY(15%);
      opacity: 1;
    }
    100% {
      transform: scale(1) translate(0);
      opacity: 1;
    }
  }

  .filter-wrapper {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-block: 2rem;
  }

  .filter-button {
    padding: 0.4rem 1rem;
    border: 1px solid #4d9940;
    background: white;
    color: #4d9940;
    border-radius: 20px;
    cursor: pointer;
    font-size: 14px;
    transition: all 0.2s;

    &:hover {
      background: rgba(77, 153, 64, 0.1);
    }

    &.active {
      background: #4d9940;
      color: white;
    }
  }

  .consignment-store__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 0.5rem;
    margin-top: 1rem;

    @media (min-width: 480px) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .store-card {
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid #ddd;
    padding: 1rem 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    transition: transform 0.2s;

    &:hover {
      transform: translateY(-2px);
      background: rgba(255, 255, 255, 0.9);
    }

    &[style*="display: none"] {
      // フィルタリング時のアニメーション用
    }

    &.is-participant {
      // background: rgba(77, 153, 64, 0.15); // テーマカラーの薄い緑
      border-color: #ff666699;
      box-shadow: 0 1px 3px rgba(255, 102, 102, 0.7);
      
    }
  }
  .store-card__badge--participant {
    display: inline-block;
    border: 1px solid #ff6666;
    border-radius: 100vw;
    width: fit-content;
    padding: 0.1rem 0.6rem;
    background: white;
    color: #ff6666;
    font-size: 10px;  }

  .store-card__badge {
    display: inline-block;
    width: fit-content;
    padding: 0.1rem 0.6rem;
    background: #4d9940;
    color: white;
    font-size: 10px;
    border-radius: 100vw;
    margin-bottom: -0.4rem; // 名前との距離を詰める
  }

  .store-card__name {
    margin: 0;
    font-size: 1.1rem;
    font-weight: bold;
    color: #333;
    line-height: 1.3;
  }

  .store-card__info {
    font-size: 13px;
    color: #666;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .store-card__address {
    margin: 0;
    display: flex;
    &::before {
      content: "📍";
      margin-right: 4px;
      display: inline-block;
    }
  }

  .store-card__tel {
    margin: 0;
    a {
      color: inherit;
      text-decoration: none;
      &::before {
        content: "📞";
        margin-right: 4px;
        display: inline-block;
      }
    }
  }
  .store-card__links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin-top: auto;
  }
  [class*="store-card__link--"] {
    display: block;
    text-align: center;
    padding: 0.5rem;
    border: 1px solid #4d9940;
    background: #4d9940;
    color: white;
    text-decoration: none;
    font-size: 13px;
    border-radius: 4px;
    transition: all 0.3s ease-out;

    &:hover {
      background: #3d7a33;
    }
  }
  .store-card__link--tel {
    background-color: transparent;
    color: #4d9940;
    &:hover {
      background: rgba(77, 153, 64, 0.1);
    }
  }
  .store-card__link--map {
  }
</style>

<script>
  const filterButtons = document.querySelectorAll(".filter-button");
  const storeCards = document.querySelectorAll(".store-card");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      // ボタンの活性状態を切り替え
      filterButtons.forEach((btn) => btn.classList.remove("active"));
      button.classList.add("active");

      const filter = (button as HTMLButtonElement).dataset.filter;

      storeCards.forEach((card) => {
        const area = (card as HTMLElement).dataset.area;
        if (filter === "all" || area === filter) {
          (card as HTMLElement).style.display = "flex";
        } else {
          (card as HTMLElement).style.display = "none";
        }
      });
    });
  });
</script>
